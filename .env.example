# Copy to .env (gitignored) and fill in only what you decide to use. Scripts read keys from here; nothing prints them.

# fal.ai: image generation (style frames, backgrounds, skins), image-to-3D, Patina materials, sound effects and music.
# Create a key at https://fal.ai/dashboard/keys. Set a budget cap in Docs/TASK.md before the first paid call.
FAL_KEY=

# Optional: direct Tripo API (only if we ever need AI 3D meshes; D008 says procedural first).
TRIPO_API_KEY=

# Blender for background batches (only after Blender is installed).
BLENDER_EXE=/Applications/Blender.app/Contents/MacOS/Blender
